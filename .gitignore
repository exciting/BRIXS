# ignore all module/object files (only relevant for stray in-source builds;
# the CMake build puts these in build/ instead, see below)
*.o
*.mod
#ignore out-of-source CMake build directories
build/
build-*/
#ignore vim swp files
.*.swp
tags
#ignore executables in bin
bin/*
!bin/.gitkeep
#ignore testdata
test/data/diamond/pathway/data.h5
test/data/diamond/pathway/rixs.h5
test/data/diamond/coherence/rixs.h5
test/data/lif/rixs.h5
test/data/lif/data.h5
